# Enterprise Integration Modernization agent environment template.
# Copy this file to agent/.env for local development. Do not commit agent/.env.

# ---------------------------------------------------------------------------
# App identity
# ---------------------------------------------------------------------------
ENVIRONMENT=dev
AGENT_NAME=enterprise-integration-agent
AGENT_RUNTIME_MODE=local

# ---------------------------------------------------------------------------
# MCP execution mode
# Local mock mode is the safe default.
# To enable real remote MCP execution:
#   1. Set MOCK_MCP=false
#   2. Set MCP_EXECUTION_MODE=remote
#   3. Set MCP_SERVER_URL or per-tool endpoints
# ---------------------------------------------------------------------------
MOCK_MCP=true
MCP_EXECUTION_MODE=mock
MCP_SERVER_NAME=logic-apps-standard-mcp
MCP_SERVER_URL=
MCP_TOOL_ENDPOINT_GET_ORDER_STATUS=
MCP_TOOL_ENDPOINT_CHECK_SHIPMENT_STATUS=
MCP_TOOL_ENDPOINT_VALIDATE_INVOICE=
MCP_TOOL_ENDPOINT_QUERY_INTEGRATION_RUN_STATUS=
MCP_TOOL_ENDPOINT_CREATE_APPROVAL_REQUEST=
MCP_TOOL_ENDPOINT_CREATE_SERVICENOW_TICKET=
MCP_TOOL_ENDPOINT_SEND_SUPPLIER_NOTIFICATION=
MCP_API_KEY=
MCP_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Microsoft Foundry runtime placeholders
# ---------------------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=
MODEL_DEPLOYMENT_NAME=
FOUNDRY_AGENT_NAME=enterprise-integration-agent
FOUNDRY_AGENT_VERSION=2
FOUNDRY_EVAL_DATASET_NAME=enterprise-mcp-regression
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_ACCOUNT_NAME=
AZURE_AI_PROJECT_NAME=

# ---------------------------------------------------------------------------
# Azure observability placeholders
# ---------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_ANALYTICS_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Azure identity and secret management placeholders
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
KEY_VAULT_URL=
SERVICE_BUS_NAMESPACE=
