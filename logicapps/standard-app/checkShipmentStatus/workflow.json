{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "shipment_id"
            ],
            "properties": {
              "shipment_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "actions": {
      "Compose_shipment_status_response": {
        "type": "Compose",
        "inputs": {
          "requestedShipmentId": "@triggerBody()?['shipment_id']",
          "orderNumber": "4500098123",
          "shipmentStatus": "In Transit",
          "eta": "2026-05-21",
          "delayRisk": "Medium",
          "correlationId": "@coalesce(triggerOutputs()?['headers']?['x-correlation-id'], workflow()?['run']?['name'])"
        },
        "runAfter": {}
      },
      "Return_shipment_status": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "@outputs('Compose_shipment_status_response')"
        },
        "runAfter": {
          "Compose_shipment_status_response": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
