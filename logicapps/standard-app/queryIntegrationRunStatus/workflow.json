{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "correlation_id"
            ],
            "properties": {
              "correlation_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "actions": {
      "Compose_run_status_response": {
        "type": "Compose",
        "inputs": {
          "runId": "RUN-90001",
          "requestedCorrelationId": "@triggerBody()?['correlation_id']",
          "status": "Failed",
          "errorCategory": "BACKEND_TIMEOUT",
          "correlationId": "@triggerBody()?['correlation_id']"
        },
        "runAfter": {}
      },
      "Return_run_status": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "@outputs('Compose_run_status_response')"
        },
        "runAfter": {
          "Compose_run_status_response": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
