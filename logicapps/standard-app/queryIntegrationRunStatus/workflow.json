{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "server_name",
              "tool_name",
              "correlation_id",
              "payload"
            ],
            "properties": {
              "server_name": {
                "type": "string",
                "description": "MCP server name expected by the workflow. Use logic-apps-standard-mcp."
              },
              "tool_name": {
                "type": "string",
                "description": "Approved MCP tool name. Must be queryIntegrationRunStatus for this workflow."
              },
              "correlation_id": {
                "type": "string",
                "description": "Correlation ID used for audit, tracing, troubleshooting, and response correlation."
              },
              "payload": {
                "type": "object",
                "required": [
                  "correlation_id"
                ],
                "properties": {
                  "correlation_id": {
                    "type": "string",
                    "description": "Correlation ID for the integration run to investigate."
                  }
                },
                "additionalProperties": true,
                "description": "Tool-specific payload for the queryIntegrationRunStatus workflow. Provide the correlation ID from an integration run or support case."
              },
              "timeout_seconds": {
                "type": "integer",
                "description": "Optional requested timeout in seconds for the MCP tool execution."
              }
            },
            "additionalProperties": true,
            "description": "MCP request envelope for the queryIntegrationRunStatus tool."
          }
        },
        "description": "Use this tool to retrieve read-only integration run status and troubleshooting details for a known correlation ID. Requires payload.correlation_id."
      }
    },
    "actions": {
      "Validate_mcp_envelope": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@triggerBody()?['tool_name']",
                "queryIntegrationRunStatus"
              ]
            },
            {
              "not": {
                "equals": [
                  "@triggerBody()?['payload']?['correlation_id']",
                  null
                ]
              }
            },
            {
              "not": {
                "equals": [
                  "@triggerBody()?['payload']?['correlation_id']",
                  ""
                ]
              }
            }
          ]
        },
        "actions": {
          "Compose_run_status_result": {
            "type": "Compose",
            "inputs": {
              "runId": "RUN-90001",
              "requestedCorrelationId": "@triggerBody()?['payload']?['correlation_id']",
              "status": "Failed",
              "errorCategory": "BACKEND_TIMEOUT",
              "correlationId": "@coalesce(triggerBody()?['correlation_id'], triggerOutputs()?['headers']?['x-correlation-id'], workflow()?['run']?['name'])"
            }
          },
          "Return_mcp_run_status": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "status": "completed",
                "result": "@outputs('Compose_run_status_result')",
                "message": "Remote MCP execution completed by local Logic Apps workflow."
              }
            },
            "runAfter": {
              "Compose_run_status_result": [
                "Succeeded"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Return_invalid_mcp_request": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 400,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "status": "failed",
                  "error": "invalid_mcp_request",
                  "message": "The queryIntegrationRunStatus workflow requires tool_name=queryIntegrationRunStatus and payload.correlation_id."
                }
              }
            }
          }
        },
        "runAfter": {}
      }
    },
    "outputs": {},
    "description": "Use this tool to retrieve read-only integration run status and troubleshooting details for a known correlation ID. Requires payload.correlation_id."
  },
  "kind": "Stateful"
}
