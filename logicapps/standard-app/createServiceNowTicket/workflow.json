{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "shortDescription": {
                "type": "string"
              },
              "assignmentGroup": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "actions": {
      "Compose_servicenow_ticket_response": {
        "type": "Compose",
        "inputs": {
          "ticketNumber": "INC0012345",
          "status": "Created",
          "assignmentGroup": "@coalesce(triggerBody()?['assignmentGroup'], 'Integration Support')",
          "correlationId": "@coalesce(triggerOutputs()?['headers']?['x-correlation-id'], workflow()?['run']?['name'])"
        },
        "runAfter": {}
      },
      "Return_servicenow_ticket": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "@outputs('Compose_servicenow_ticket_response')"
        },
        "runAfter": {
          "Compose_servicenow_ticket_response": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
