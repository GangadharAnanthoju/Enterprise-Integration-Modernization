{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "server_name",
              "tool_name",
              "correlation_id",
              "payload"
            ],
            "properties": {
              "server_name": {
                "type": "string",
                "description": "MCP server name expected by the workflow. Use logic-apps-standard-mcp."
              },
              "tool_name": {
                "type": "string",
                "description": "Approved MCP tool name. Must be checkShipmentStatus for this workflow."
              },
              "correlation_id": {
                "type": "string",
                "description": "Correlation ID used for audit, tracing, troubleshooting, and response correlation."
              },
              "payload": {
                "type": "object",
                "required": [
                  "shipment_id"
                ],
                "properties": {
                  "shipment_id": {
                    "type": "string",
                    "description": "Business shipment identifier to check, for example SHIP-3001."
                  }
                },
                "additionalProperties": true,
                "description": "Tool-specific payload for the checkShipmentStatus workflow. Provide the shipment identifier to look up shipment progress."
              },
              "timeout_seconds": {
                "type": "integer",
                "description": "Optional requested timeout in seconds for the MCP tool execution."
              }
            },
            "additionalProperties": true,
            "description": "MCP request envelope for the checkShipmentStatus tool."
          }
        },
        "description": "Use this tool to retrieve read-only shipment status, carrier, and estimated delivery details for a shipment. Requires payload.shipment_id such as SHIP-3001. Does not create or update records."
      }
    },
    "actions": {
      "Validate_mcp_envelope": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@triggerBody()?['tool_name']",
                "checkShipmentStatus"
              ]
            },
            {
              "not": {
                "equals": [
                  "@triggerBody()?['payload']?['shipment_id']",
                  null
                ]
              }
            },
            {
              "not": {
                "equals": [
                  "@triggerBody()?['payload']?['shipment_id']",
                  ""
                ]
              }
            }
          ]
        },
        "actions": {
          "Compose_shipment_status_result": {
            "type": "Compose",
            "inputs": {
              "requestedShipmentId": "@triggerBody()?['payload']?['shipment_id']",
              "orderNumber": "4500098123",
              "shipmentStatus": "In Transit",
              "eta": "2026-05-21",
              "delayRisk": "Medium",
              "correlationId": "@coalesce(triggerBody()?['correlation_id'], triggerOutputs()?['headers']?['x-correlation-id'], workflow()?['run']?['name'])"
            }
          },
          "Return_mcp_shipment_status": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "status": "completed",
                "result": "@outputs('Compose_shipment_status_result')",
                "message": "Remote MCP execution completed by local Logic Apps workflow."
              }
            },
            "runAfter": {
              "Compose_shipment_status_result": [
                "Succeeded"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Return_invalid_mcp_request": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 400,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "status": "failed",
                  "error": "invalid_mcp_request",
                  "message": "The checkShipmentStatus workflow requires tool_name=checkShipmentStatus and payload.shipment_id."
                }
              }
            }
          }
        },
        "runAfter": {}
      }
    },
    "outputs": {},
    "description": "Use this tool to retrieve read-only shipment status, carrier, and estimated delivery details for a shipment. Requires payload.shipment_id such as SHIP-3001. Does not create or update records."
  },
  "kind": "Stateful"
}
